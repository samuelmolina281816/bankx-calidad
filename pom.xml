<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent>
  <groupId>org.springframework.boot</groupId>
  <artifactId>spring-boot-starter-parent</artifactId>
  <version>3.5.16</version>
  <relativePath/>
 </parent>
 <groupId>com.bankx</groupId>
 <artifactId>bankx-calidad</artifactId>
 <version>1.0.0</version>
 <name>bankx-calidad</name>
 <description>Laboratorio sencillo de calidad de codigo</description>
 <properties>
  <java.version>17</java.version>
  <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  <!-- Datos del proyecto que se visualizará en SonarQube. -->
  <sonar.projectKey>bankx-calidad</sonar.projectKey>
  <sonar.projectName>BankX Calidad</sonar.projectName>
  <!-- Archivo XML que JaCoCo genera para SonarQube. -->
  <sonar.coverage.jacoco.xmlReportPaths>
   target/site/jacoco/jacoco.xml
  </sonar.coverage.jacoco.xmlReportPaths>
 </properties>
 <dependencies>
  <!-- Permite crear el servicio HTTP reactivo. -->
  <dependency>
   <groupId>org.springframework.boot</groupId>
   <artifactId>spring-boot-starter-webflux</artifactId>
  </dependency>
  <!-- Herramientas de pruebas: JUnit, Spring Test y otras. -->
  <dependency>
   <groupId>org.springframework.boot</groupId>
   <artifactId>spring-boot-starter-test</artifactId>
   <scope>test</scope>
  </dependency>
  <!-- Permite probar Mono y Flux con StepVerifier. -->
  <dependency>
   <groupId>io.projectreactor</groupId>
   <artifactId>reactor-test</artifactId>
   <scope>test</scope>
  </dependency>
 </dependencies>
 <build>
  <plugins>
   <!-- Permite empaquetar y ejecutar Spring Boot. -->
   <plugin>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-maven-plugin</artifactId>
   </plugin>

    <!--  CHECKSTYLE:
              verifica el estilo del código en la fase verify.
            -->
   <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-checkstyle-plugin</artifactId>
    <version>3.3.1</version>
    <configuration>
     <configLocation>google_checks.xml</configLocation>
     <encoding>UTF-8</encoding>
     <consoleOutput>true</consoleOutput>
     <failOnViolation>true</failOnViolation>
     <violationSeverity>warning</violationSeverity>
    </configuration>
    <executions>
     <execution>
      <id>validar-estilo</id>
      <phase>verify</phase>
      <goals>
       <goal>check</goal>
      </goals>
     </execution>
    </executions>
   </plugin>
   <!--
   JACOCO:
   registra cobertura, genera reportes y valida umbrales.
   -->
   <plugin>
    <groupId>org.jacoco</groupId>
    <artifactId>jacoco-maven-plugin</artifactId>
    <version>0.8.12</version>
    <executions>
     <!-- Activa el agente antes de ejecutar las pruebas. -->
     <execution>
      <id>preparar-agente</id>
      <goals>
       <goal>prepare-agent</goal>
      </goals>
     </execution>
     <!-- Genera los reportes HTML y XML en la fase test. -->
     <execution>
      <id>generar-reporte</id>
      <phase>test</phase>
      <goals>
       <goal>report</goal>
      </goals>
     </execution>
     <!-- Valida los mínimos por clase en verify. -->
     <execution>
      <id>validar-cobertura</id>
      <phase>verify</phase>
      <goals>
       <goal>check</goal>
      </goals>
      <configuration>
       <rules>
        <rule>
         <element>CLASS</element>
         <!--
         Se excluye únicamente la clase de
         arranque de esta validación.
         -->
         <excludes>
          <exclude>
           *.BankxApplication
          </exclude>
         </excludes>
         <limits>
          <limit>
           <counter>LINE</counter>
           <value>COVEREDRATIO</value>
           <minimum>0.70</minimum>
          </limit>
          <limit>
           <counter>BRANCH</counter>
           <value>COVEREDRATIO</value>
           <minimum>0.60</minimum>
          </limit>
         </limits>
        </rule>
       </rules>
      </configuration>
     </execution>
    </executions>
   </plugin>
   <!-- Scanner que envía el análisis a SonarQube. -->
   <plugin>
    <groupId>org.sonarsource.scanner.maven</groupId>
    <artifactId>sonar-maven-plugin</artifactId>
    <version>5.1.0.4751</version>
   </plugin>
  </plugins>
 </build>
</project>
